# Database Configuration
# Use your Supabase connection string here. 
# DATABASE_URL is for transaction pooling (Port 6543)
# DIRECT_URL is for direct session connection (Migrations - Port 5432)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase Auth Configuration
# Found in Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Site URL (Optional, for Auth redirects)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional product analytics. Leave disabled for local development and tests.
# The PostHog project key is publishable; never use a private admin API token here.
NEXT_PUBLIC_RMD_ANALYTICS_ENABLED="0"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Typesense Search
# Found in your Typesense Cloud dashboard or self-hosted config
NEXT_PUBLIC_TYPESENSE_HOST="your-cluster.typesense.net"
NEXT_PUBLIC_TYPESENSE_PORT="443"
NEXT_PUBLIC_TYPESENSE_PROTOCOL="https"
NEXT_PUBLIC_TYPESENSE_SEARCH_KEY="your-search-only-api-key"
TYPESENSE_ADMIN_KEY="your-admin-api-key"
